{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "packages"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "packages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "description"],
        "properties": {
          "repo": {
            "type": "string",
            "description": "GitHub owner/repo (e.g., tl-nguyen/exo-pkg-bmad)",
            "pattern": "^[\\w.-]+/[\\w.-]+$"
          },
          "description": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["framework", "tool", "agent", "template"]
          },
          "verified": {
            "type": "boolean",
            "description": "Whether this package has been reviewed and approved"
          }
        }
      }
    }
  }
}
